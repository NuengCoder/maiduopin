<view class="page address-edit-page">
  <navigation-bar title="{{id ? '编辑地址' : '新增地址'}}" back="{{true}}" color="#1A1A1A" background="#FFFFFF" />

  <view class="form-card">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input
        class="form-input"
        value="{{form.receiver}}"
        placeholder="请输入收货人姓名"
        placeholder-class="form-placeholder"
        data-field="receiver"
        bindinput="onField"
      />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        value="{{form.phone}}"
        placeholder="请输入手机号"
        placeholder-class="form-placeholder"
        data-field="phone"
        bindinput="onField"
      />
    </view>
    <view class="form-row">
      <text class="form-label">所在地区</text>
      <input
        class="form-input"
        value="{{form.region}}"
        placeholder="如：广东省 深圳市 南山区"
        placeholder-class="form-placeholder"
        data-field="region"
        bindinput="onField"
      />
    </view>
    <view class="form-row form-row-detail">
      <text class="form-label">详细地址</text>
      <textarea
        class="form-textarea"
        value="{{form.detail}}"
        placeholder="街道、门牌号、楼栋等"
        placeholder-class="form-placeholder"
        maxlength="120"
        data-field="detail"
        bindinput="onField"
      />
    </view>
    <view class="form-row switch-row">
      <view class="switch-info">
        <text class="form-label">设为默认地址</text>
        <text class="switch-desc">下单时优先使用该地址</text>
      </view>
      <switch checked="{{form.isDefault}}" color="#E02E24" bindchange="onDefaultChange" />
    </view>
  </view>

  <view class="save-bar">
    <button class="save-btn {{saving ? 'disabled' : ''}}" bindtap="save">
      {{saving ? '保存中...' : '保存地址'}}
    </button>
  </view>
</view>
