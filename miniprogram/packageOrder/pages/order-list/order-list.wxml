<view class="page order-list-page">
  <navigation-bar title="我的订单" back="{{true}}" color="#1A1A1A" background="#FFFFFF" />

  <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tabs-track">
      <view
        class="tab {{active === item.key ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTab"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="order-content">
    <view class="order-loading" wx:if="{{loading}}">
      <view class="skeleton skeleton-order" wx:for="{{[1, 2, 3]}}" wx:key="*this"></view>
    </view>

    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <view class="order-head" data-id="{{item.id}}" bindtap="goDetail">
        <text class="order-no">订单号 {{item.orderNo}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>

      <view class="order-items" data-id="{{item.id}}" bindtap="goDetail">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="goods" wx:key="skuId">
          <view class="order-thumb thumb-relative">
            <image class="thumb-fill" src="{{goods.image}}" mode="aspectFill" lazy-load />
            <text class="cover-emoji cover-emoji--sm">{{goods.coverEmoji}}</text>
          </view>
          <view class="order-info">
            <view class="order-title ellipsis-2">{{goods.title}}</view>
            <view class="order-spec">{{goods.specName}}</view>
          </view>
          <view class="order-price">
            <view class="price-value">¥{{goods.unitPriceText}}</view>
            <view class="price-qty">×{{goods.quantity}}</view>
          </view>
        </view>
      </view>

      <view class="order-summary">
        <text>共 {{item.itemCount}} 件</text>
        <text class="summary-total">实付 <text class="summary-amount">¥{{item.payText}}</text></text>
      </view>

      <view class="order-actions">
        <block wx:if="{{item.status === 'PENDING_PAYMENT'}}">
          <button class="action-btn ghost" data-id="{{item.id}}" catchtap="cancelOrder">取消订单</button>
          <button class="action-btn primary" data-id="{{item.id}}" catchtap="payOrder">去支付</button>
        </block>
        <block wx:elif="{{item.status === 'SHIPPED'}}">
          <button class="action-btn ghost" data-id="{{item.id}}" catchtap="goDetail">查看物流</button>
          <button class="action-btn primary" data-id="{{item.id}}" catchtap="confirmOrder">确认收货</button>
        </block>
        <block wx:else>
          <button class="action-btn ghost" data-id="{{item.id}}" catchtap="goDetail">查看详情</button>
        </block>
      </view>
    </view>

    <empty-state
      wx:if="{{!loading && !orders.length}}"
      icon="📦"
      title="暂无相关订单"
      subtitle="去逛逛，发现更多好物"
      actionText="去逛逛"
      bindaction="goHome"
    />
  </view>
</view>
